# Copy this file to .env and adjust as needed.
PORT=8000

# MongoDB MUST be running as a replica set (even a single-node one) because
# this project relies on multi-document ACID transactions for the
# transactional-outbox pattern and optimistic concurrency control.
# See README.md "Running it" for one-command setup instructions.
MONGO_URI=mongodb://127.0.0.1:27017/idempotent_events?replicaSet=rs0
